{
  "analyst_targets": {
    "title": "分析师目标价",
    "description": "第三方分析师数据，不是本平台预测。",
    "effect": "read",
    "input_schema": {
      "type": "object",
      "properties": {
        "market": {
          "type": "string",
          "title": "市场",
          "enum": [
            "HK",
            "US"
          ],
          "default": "HK"
        },
        "symbol": {
          "type": "string",
          "title": "股票代码",
          "minLength": 1,
          "maxLength": 16,
          "description": "只填代码：SH600519 / 00700 / NVDA"
        },
        "provider": {
          "type": "string",
          "title": "公开数据源",
          "enum": [
            "auto",
            "yfinance"
          ],
          "default": "auto"
        },
        "limit": {
          "type": "integer",
          "title": "最多返回行数",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": [
        "market",
        "symbol"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "market": {
                "const": "HK"
              }
            },
            "required": [
              "market"
            ]
          },
          "then": {
            "properties": {
              "provider": {
                "enum": [
                  "auto",
                  "yfinance"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "market": {
                "const": "US"
              }
            },
            "required": [
              "market"
            ]
          },
          "then": {
            "properties": {
              "provider": {
                "enum": [
                  "auto",
                  "yfinance"
                ]
              }
            }
          }
        }
      ]
    }
  },
