{
  "list_top": {
    "title": "热门消息",
    "description": "浏览器读取官方热门页面，一次返回完整新闻条目；data.items 包含 id/title/url/comments_url/score/descendants/by/time，缺失元数据为 null。最多 30 条，不再逐条读取 get_item。",
    "effect": "read",
    "input_schema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 10
        }
      },
      "additionalProperties": false
    },
    "browser_action": {
      "kind": "records",
      "requires_auth": false,
      "url_template": "https://news.ycombinator.com/",
      "root_selector": "table.itemlist",
      "item_selector": "tr.athing",
      "ready_selector": "tr.athing .titleline a",
      "fields": {
        "id": {
          "selector": ":scope",
          "attribute": "id",
          "type": "integer",
          "required": true
        },
        "title": {
          "selector": ".titleline a",
          "required": true
        },
        "url": {
          "selector": ".titleline a",
          "attribute": "href",
          "required": true
        },
        "comments_url": {
          "selector": ".age a",
          "scope": "next_sibling",
          "attribute": "href",
          "nullable": true
        },
        "score": {
          "selector": ".score",
          "scope": "next_sibling",
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "descendants": {
          "selector": ".subline > a:last-child",
          "scope": "next_sibling",
          "values": {
            "discuss": "0"
          },
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "by": {
          "selector": ".hnuser",
          "scope": "next_sibling",
          "nullable": true
        },
        "time": {
          "selector": ".age",
          "scope": "next_sibling",
          "attribute": "title",
          "pattern": "\\s(\\d+)$",
          "type": "integer",
          "nullable": true
        }
      },
      "default_limit": 10,
      "max_scrolls": 0
    }
  },
  "list_new": {
    "title": "最新消息",
    "description": "浏览器读取官方最新页面，一次返回完整新闻条目；data.items 包含 id/title/url/comments_url/score/descendants/by/time，缺失元数据为 null。最多 30 条，不再逐条读取 get_item。",
    "effect": "read",
    "input_schema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 10
        }
      },
      "additionalProperties": false
    },
    "browser_action": {
      "kind": "records",
      "requires_auth": false,
      "url_template": "https://news.ycombinator.com/newest",
      "root_selector": "table.itemlist",
      "item_selector": "tr.athing",
      "ready_selector": "tr.athing .titleline a",
      "fields": {
        "id": {
          "selector": ":scope",
          "attribute": "id",
          "type": "integer",
          "required": true
        },
        "title": {
          "selector": ".titleline a",
          "required": true
        },
        "url": {
          "selector": ".titleline a",
          "attribute": "href",
          "required": true
        },
        "comments_url": {
          "selector": ".age a",
          "scope": "next_sibling",
          "attribute": "href",
          "nullable": true
        },
        "score": {
          "selector": ".score",
          "scope": "next_sibling",
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "descendants": {
          "selector": ".subline > a:last-child",
          "scope": "next_sibling",
          "values": {
            "discuss": "0"
          },
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "by": {
          "selector": ".hnuser",
          "scope": "next_sibling",
          "nullable": true
        },
        "time": {
          "selector": ".age",
          "scope": "next_sibling",
          "attribute": "title",
          "pattern": "\\s(\\d+)$",
          "type": "integer",
          "nullable": true
        }
      },
      "default_limit": 10,
      "max_scrolls": 0
    }
  },
  "get_item": {
    "title": "帖子详情",
    "description": "按帖子 ID 读取官方页面。data.items 为详情数组。只读取帖子详情，不加载评论树。",
    "effect": "read",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "browser_action": {
      "kind": "detail",
      "requires_auth": false,
      "url_template": "https://news.ycombinator.com/item?id={id}",
      "root_selector": "table.fatitem",
      "item_selector": "table.fatitem",
      "fields": {
        "id": {
          "selector": "tr.athing",
          "attribute": "id",
          "type": "integer",
          "required": true
        },
        "title": {
          "selector": ".titleline a",
          "required": true
        },
        "url": {
          "selector": ".titleline a",
          "attribute": "href",
          "required": true
        },
        "comments_url": {
          "selector": ".subtext .age a",
          "attribute": "href",
          "nullable": true
        },
        "score": {
          "selector": ".subtext .score",
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "descendants": {
          "selector": ".subtext .subline > a:last-child",
          "values": {
            "discuss": "0"
          },
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "by": {
          "selector": ".subtext .hnuser",
          "nullable": true
        },
        "time": {
          "selector": ".subtext .age",
          "attribute": "title",
          "pattern": "\\s(\\d+)$",
          "type": "integer",
          "nullable": true
        },
        "text": {
          "selector": ".toptext",
          "nullable": true
        }
      },
      "default_limit": 1,
      "max_scrolls": 0
    }
  },
  "discussion": {
    "title": "帖子讨论",
    "description": "按帖子 ID 读取官方页面。data.items 为详情数组。附带页面已加载的前 50 条评论，按 DOM 顺序平铺；不是完整评论树，不自动翻页。",
    "effect": "read",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "browser_action": {
      "kind": "detail",
      "requires_auth": false,
      "url_template": "https://news.ycombinator.com/item?id={id}",
      "root_selector": "table.fatitem",
      "item_selector": "table.fatitem",
      "fields": {
        "id": {
          "selector": "tr.athing",
          "attribute": "id",
          "type": "integer",
          "required": true
        },
        "title": {
          "selector": ".titleline a",
          "required": true
        },
        "url": {
          "selector": ".titleline a",
          "attribute": "href",
          "required": true
        },
        "comments_url": {
          "selector": ".subtext .age a",
          "attribute": "href",
          "nullable": true
        },
        "score": {
          "selector": ".subtext .score",
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "descendants": {
          "selector": ".subtext .subline > a:last-child",
          "values": {
            "discuss": "0"
          },
          "pattern": "^(\\d+)",
          "type": "integer",
          "nullable": true
        },
        "by": {
          "selector": ".subtext .hnuser",
          "nullable": true
        },
        "time": {
          "selector": ".subtext .age",
          "attribute": "title",
          "pattern": "\\s(\\d+)$",
          "type": "integer",
          "nullable": true
        },
        "text": {
          "selector": ".toptext",
          "nullable": true
        }
      },
      "default_limit": 1,
      "max_scrolls": 0,
      "comment_selector": "tr.comtr",
      "comment_fields": {
        "id": {
          "selector": ":scope",
          "attribute": "id",
          "type": "integer",
          "required": true
        },
        "author": {
          "selector": ".hnuser",
          "nullable": true
        },
        "text": {
          "selector": ".commtext",
          "nullable": true
        }
      },
      "comment_limit": 50
    }
  }
}
